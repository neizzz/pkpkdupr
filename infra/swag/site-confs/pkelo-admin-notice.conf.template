server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name __PKELO_ADMIN_DOMAIN__;

    include /config/nginx/pkelo-ssl.conf;

    default_type application/json;
    add_header Cache-Control "no-store" always;
    add_header X-Pkelo-Notice "active" always;

    location / {
        return 503 '{"code":"PKELO_NOTICE_ACTIVE"}';
    }
}
