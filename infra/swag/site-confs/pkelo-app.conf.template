server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name __PKELO_DOMAIN__;

    include /config/nginx/pkelo-ssl.conf;

    client_max_body_size 10m;

    location = /api {
        return 404;
    }

    location ^~ /api/ {
        proxy_pass http://pkelo-api:4000;
        include /config/nginx/proxy.conf;
    }

    location ^~ /uploads/ {
        proxy_pass http://pkelo-api:4000;
        include /config/nginx/proxy.conf;
    }

    location ^~ /auth/kakao/ {
        proxy_pass http://pkelo-api:4000;
        include /config/nginx/proxy.conf;
    }

    location / {
        proxy_pass http://pkelo-web:80;
        include /config/nginx/proxy.conf;
    }
}
