# pkelo.app는 별도 Cloudflare DNS-01 인증서를 사용하므로 주 SWAG의 ssl.conf를
# 재사용하지 않습니다. 주 SWAG 컨테이너에는 인증서 디렉터리만 읽기 전용으로 마운트됩니다.
ssl_certificate /config/pkelo-certs/live/__PKELO_DOMAIN__/fullchain.pem;
ssl_certificate_key /config/pkelo-certs/live/__PKELO_DOMAIN__/privkey.pem;
ssl_trusted_certificate /config/pkelo-certs/live/__PKELO_DOMAIN__/fullchain.pem;

ssl_dhparam /config/nginx/dhparams.pem;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_prefer_server_ciphers on;
ssl_session_timeout 1d;
ssl_session_cache shared:PKELSSL:10m;
ssl_session_tickets off;
ssl_stapling on;
ssl_stapling_verify on;
resolver 1.1.1.1 1.0.0.1 valid=300s;
resolver_timeout 5s;
