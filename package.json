{
   "name": "pkpkdupr",
    "version": "0.0.1",
    "private": true,
    "description": "Pickleball DUPR System - Monorepo with pnpm",
    "scripts": {
    "dev": "bash scripts/dev-pkelo.sh",
    "dev:db": "bash scripts/dev-pkelo-db.sh",
    "dev:db:down": "bash scripts/dev-pkelo-db.sh down",
    "dev:db-browser": "bash scripts/dev-pkelo-db.sh browser",
    "dev:db-browser:down": "bash scripts/dev-pkelo-db.sh browser-down",
        "dev:pkelo": "bash scripts/dev-pkelo.sh",
        "dev:pkelo:db": "bash scripts/dev-pkelo-db.sh",
        "dev:pkelo:db:down": "bash scripts/dev-pkelo-db.sh down",
        "dev:pkelo:db-browser": "bash scripts/dev-pkelo-db.sh browser",
        "dev:pkelo:db-browser:down": "bash scripts/dev-pkelo-db.sh browser-down",
        "dev:web": "pnpm --filter @pkpkdupr/web dev",
        "dev:api": "pnpm --filter @pkpkdupr/api dev",
        "dev:admin": "pnpm --filter @pkpkdupr/admin-web dev",
        "prepare": "node --input-type=module -e \"import { existsSync } from 'node:fs'; if (existsSync('./scripts/setup-git-hooks.mjs')) await import('./scripts/setup-git-hooks.mjs')\"",
        "build": "pnpm -r build",
        "build:web": "pnpm --filter @pkpkdupr/web build",
        "build:api": "pnpm --filter @pkpkdupr/api build",
        "build:admin": "pnpm --filter @pkpkdupr/admin-web build",
        "verify:pre-push": "pnpm build",
        "lint": "pnpm -r lint",
        "clean": "pnpm -r --parallel clean",
        "db:migrate": "pnpm --filter @pkpkdupr/db-server exec tsx src/db/migrate.ts",
        "db:import-sqlite": "pnpm --filter @pkpkdupr/db-server exec tsx src/db/importSqlite.ts"
    },
    "devDependencies": {
        "typescript": "^5.3.3"
   },
    "engines": {
       "pnpm": ">=8.0.0"
   }
}
