# PKELO 로컬 개발 전용 설정입니다. 필요하면 env/pkelo.dev.env로 복사해 값을 바꾸세요.
# 이 파일은 운영용 env/pkelo.env 및 기존 앱 .env와 공유하지 않습니다.
DOMAIN=pkelo.localhost
JWT_SECRET=pkelo-local-dev-jwt-secret
PKELO_DEV_WEB_PORT=8443
PKELO_DEV_WEB_ORIGIN=http://localhost:8443
USER_AUTH_PROVIDER=kakao-mock
KAKAO_REDIRECT_URI=http://localhost:8443/auth/kakao/callback
KAKAO_WEB_ORIGIN=http://localhost:8443
KAKAO_MOCK_SUBJECT=pkelo-local-mock-user
API_ADMIN_USERNAME=admin
API_ADMIN_PASSWORD=admin123qwe
MYSQL_DATABASE=pkelo_dev
MYSQL_USER=pkelo_dev
MYSQL_PASSWORD=pkelo-dev-password
MYSQL_ROOT_PASSWORD=pkelo-dev-root-password
MYSQL_VIEWER_USER=pkelo_dev_viewer
MYSQL_VIEWER_PASSWORD=pkelo-dev-viewer-password

# HTTPS 프록시로 실카카오 로그인을 확인할 때는 아래 값으로 교체하고,
# 동일한 Redirect URI를 카카오디벨로퍼스에도 등록하세요.
# PKELO_DEV_WEB_ORIGIN=https://neiz-office2.fedev.kakao.com
# KAKAO_WEB_ORIGIN=https://neiz-office2.fedev.kakao.com
# KAKAO_REDIRECT_URI=https://neiz-office2.fedev.kakao.com/auth/kakao/callback

# PKELO 개발 서비스 포트 (기본값: web 8443, MySQL 3307, Adminer 3302)
# PKELO_DEV_MYSQL_PORT=3307
# PKELO_DEV_ADMINER_PORT=3302
