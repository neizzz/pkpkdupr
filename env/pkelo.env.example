# env-version: v1
# pkelo.app 앱 전용 Cloudflare·Kakao 인증·DB·업로드 설정입니다. pkpkdupr와 시크릿을 공유하지 마세요.
# 항목 추가·삭제·필수값 변경으로 운영 서버의 pkelo.env 갱신이 필요할 때만 버전을 올립니다.
# 주석·문서만 바꾸는 경우에는 버전을 유지합니다.
DOMAIN=pkelo.app
CLOUDFLARE_DNS_API_TOKEN=replace-with-a-cloudflare-dns-api-token
JWT_SECRET=replace-with-a-different-secure-random-secret
USER_AUTH_PROVIDER=kakao
KAKAO_REST_API_KEY=replace-with-your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=replace-with-your-kakao-client-secret
KAKAO_REDIRECT_URI=https://pkelo.app/auth/kakao/callback
KAKAO_WEB_ORIGIN=https://pkelo.app
API_ADMIN_USERNAME=admin
API_ADMIN_PASSWORD=replace-with-a-strong-password
MYSQL_DATABASE=pkelo
MYSQL_USER=pkelo
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_VIEWER_USER=pkelo_viewer
MYSQL_VIEWER_PASSWORD=replace-with-a-strong-viewer-password
APP_DATA_PATH=/opt/pkpkdupr/data/pkelo

# Optional: 이 앱에만 허용할 추가 개발 origin(쉼표 구분)
# CORS_ADDITIONAL_ORIGINS=https://neiz-office.fedev.kakao.com
