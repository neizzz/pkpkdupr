# env-version: v1
# 공용 프록시·이미지·gateway 설정입니다. 앱별 DB/JWT/DNS 시크릿은 넣지 마세요.
# 항목 추가·삭제·필수값 변경으로 운영 서버의 shared.env 갱신이 필요할 때만 버전을 올립니다.
# 주석·문서만 바꾸는 경우에는 버전을 유지합니다.
GHCR_NAMESPACE=neizzz
IMAGE_TAG=latest
WEB_PUBLIC_PORT=443
ADMIN_STACK_PORT=3333
GATEWAY_NETWORK=pkpkdupr-gateway
PUID=1000
PGID=1000
TZ=Asia/Seoul

# Optional: 로컬 소스 빌드에서 표시할 앱 버전
# VITE_APP_VERSION=v0.6.0
