# env-version: v1
# 공용 프록시·이미지·gateway 설정입니다. 앱별 DB/JWT/DNS 시크릿은 넣지 마세요.
# 항목 추가·삭제·필수값 변경으로 운영 서버의 shared.env 갱신이 필요할 때만 버전을 올립니다.
# 주석·문서만 바꾸는 경우에는 버전을 유지합니다.

# GHCR 컨테이너 이미지 소유자 네임스페이스입니다.
GHCR_NAMESPACE=neizzz
# 기본 배포 이미지 태그입니다. manual-deploy.sh의 --image-tag이 실행 시 덮어씁니다.
IMAGE_TAG=latest
# 사용자 웹 트래픽을 받는 HTTPS 외부 포트입니다.
WEB_PUBLIC_PORT=443
# API·관리자·Adminer를 제공하는 HTTPS 외부 포트입니다.
ADMIN_STACK_PORT=3333
# 프록시와 두 앱 스택이 공유하는 Docker bridge 네트워크 이름입니다.
GATEWAY_NETWORK=pkpkdupr-gateway
# 컨테이너가 파일을 생성할 때 사용할 호스트 사용자 ID입니다.
PUID=1000
# 컨테이너가 파일을 생성할 때 사용할 호스트 그룹 ID입니다.
PGID=1000
# 컨테이너 로그·스케줄 기준 시간대입니다.
TZ=Asia/Seoul

# 로컬 소스 빌드에서 웹 화면에 표시할 선택 버전입니다.
# VITE_APP_VERSION=v0.6.0
