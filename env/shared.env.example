# 이 env 템플릿은 infra 브랜치에서 버전 관리합니다.
# 환경변수를 추가·변경할 때는 앱 코드의 요구사항과 함께 이 파일을 갱신하세요.
# 공용 프록시·이미지 설정입니다. 앱의 DB/JWT/DNS 시크릿은 넣지 마세요.
GHCR_NAMESPACE=neizzz
IMAGE_TAG=latest
WEB_PUBLIC_PORT=443
ADMIN_STACK_PORT=3333
GATEWAY_NETWORK=pkpkdupr-gateway
PUID=1000
PGID=1000
TZ=Asia/Seoul

# Optional: 로컬 소스 빌드에서 표시할 앱 버전
# VITE_APP_VERSION=v0.6.0
