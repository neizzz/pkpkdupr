# env-version: v1
# pkpkdupr.duckdns.org 앱 전용 도메인·인증·DB·업로드 설정입니다.
# 항목 추가·삭제·필수값 변경으로 운영 서버의 pkpkdupr.env 갱신이 필요할 때만 버전을 올립니다.
# 주석·문서만 바꾸는 경우에는 버전을 유지합니다.

# 기존 pkpkdupr 공개 도메인입니다.
DOMAIN=pkpkdupr.duckdns.org
# DuckDNS DNS-01 인증서 발급·갱신에 사용하는 토큰입니다.
DUCKDNSTOKEN=replace-with-your-duckdns-token
# pkpkdupr API JWT 서명 키입니다. PKELO JWT_SECRET과 분리해야 합니다.
JWT_SECRET=replace-with-a-secure-random-secret
# 기존 앱의 사용자 인증 방식입니다. 운영에서는 password를 사용합니다.
USER_AUTH_PROVIDER=password
# 서버 시작 시 동기화하는 관리자 사용자명입니다.
API_ADMIN_USERNAME=admin
# 서버 시작 시 관리자 계정에 적용하는 비밀번호입니다.
API_ADMIN_PASSWORD=replace-with-a-strong-password
# 기존 앱 MySQL 데이터베이스 이름입니다.
MYSQL_DATABASE=pkpkdupr
# 기존 앱 MySQL 애플리케이션 계정입니다.
MYSQL_USER=pkpkdupr
# 기존 앱 MySQL 애플리케이션 계정 비밀번호입니다.
MYSQL_PASSWORD=replace-with-a-strong-password
# MySQL root 계정 비밀번호입니다.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
# Adminer 조회용 MySQL 읽기 전용 계정입니다.
MYSQL_VIEWER_USER=pkpkdupr_viewer
# Adminer 조회용 MySQL 읽기 전용 계정 비밀번호입니다.
MYSQL_VIEWER_PASSWORD=replace-with-a-strong-viewer-password
# 기존 앱의 영속 데이터와 업로드 파일 루트 경로입니다. 기존 운영값을 유지해야 합니다.
APP_DATA_PATH=/opt/pkpkdupr/data

# 이 앱에만 추가로 허용할 CORS Origin 목록입니다. 여러 값은 쉼표로 구분합니다.
# CORS_ADDITIONAL_ORIGINS=https://neiz-office.fedev.kakao.com

# pkpkdupr API/DB Server New Relic APM 활성화 여부입니다.
NEW_RELIC_ENABLED=false
# New Relic 계정의 라이선스 키입니다. 비어 있으면 APM을 시작하지 않습니다.
NEW_RELIC_LICENSE_KEY=
# EU collector 계정일 때만 설정합니다. 미설정 시 US collector 기본값을 사용합니다.
# NEW_RELIC_HOST=collector.eu01.nr-data.net
