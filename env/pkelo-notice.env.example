# env-version: v1
# PKELO 임시 안내 페이지의 공개 제목·문구 설정입니다. 활성화 상태는 pkelo-notice.sh가 state.env로 관리합니다.
# 항목 추가·삭제·필수값 변경으로 운영 서버의 pkelo-notice.env 갱신이 필요할 때만 버전을 올립니다.
# 주석·문서만 바꾸는 경우에는 버전을 유지합니다.

# 임시 안내 페이지에 표시할 제목입니다.
PKELO_NOTICE_TITLE=PKELO
# 임시 안내 페이지에 줄바꿈을 포함해 표시할 본문입니다.
PKELO_NOTICE_MESSAGE=8월 오픈 예정
